# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplacer-par-la-cle-anon
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En-tête fiable portant l'IP client selon l'hébergeur :
# x-real-ip (Vercel), cf-connecting-ip (Cloudflare), x-forwarded-for (+ TRUSTED_PROXY_HOPS)
CLIENT_IP_HEADER=x-real-ip
TRUSTED_PROXY_HOPS=1

# --- CinetPay (Mobile Money : Orange, MTN, Moov, Wave) ----------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Clé secrète de l'espace marchand, utilisée pour vérifier l'en-tête x-token (HMAC-SHA256)
CINETPAY_SECRET_KEY=

# --- Paiement direct (P1.3) -----------------------------------------------------
# Raccourcis USSD vers le menu de l'opérateur : laisser VIDE tant que le pilote ne les
# a pas validés sur de vrais téléphones (Android et iOS). Ex. {"orange":"#144#"}
USSD_CODES_JSON=
