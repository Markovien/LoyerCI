{
  "name": "loyerci",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "./scripts/test-db.sh",
    "seed": "tsx scripts/seed.ts",
    "gen:types": "(supabase gen types typescript --local --schema public > src/types/supabase.next.ts && oxfmt src/types/supabase.next.ts && mv src/types/supabase.next.ts src/types/supabase.ts) || (rm -f src/types/supabase.next.ts; exit 1)",
    "lint": "oxlint --type-aware && node scripts/check-client-imports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@pi-spi/qrcode": "1.0.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "nodemailer": "10.3.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postgres": "^3.4.9",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
